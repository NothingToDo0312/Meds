# Local: copy to .env.local. Vercel: add the same variables under
# Project > Settings > Environment Variables (Production, and Preview if you use it).
#
# Supabase project (Project Settings > API). SERVER-SIDE ONLY: these are read by
# the Next.js API routes and never sent to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the service_role key (legacy) or a secret key (sb_secret_...).
# Never the anon / publishable key: RLS blocks it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Set to false to close public sign-up; an admin then creates every account.
# ALLOW_SIGNUP=true
